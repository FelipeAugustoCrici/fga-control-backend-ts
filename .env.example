# ─── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8080
APP_ENV=development          # development | production

# ─── Database (compartilhado com o backend Go) ─────────────────────────────────
DATABASE_URL=postgresql://controltasks:controltasks@localhost:5432/controltasks

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Segurança (DEVEM ser idênticos ao .env do backend Go durante a transição) ─
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria-em-producao
FIELD_ENCRYPT_KEY=troque-por-32-chars-exatos-aqui!!

# ─── Proxy strangler-fig (só existe enquanto o Go ainda estiver no ar) ─────────
GO_BACKEND_URL=http://localhost:8080

# ─── Keycloak (Fase 1 — só validação de senha no login, opcional: se ausente ou
# fora do ar, LoginService cai pro bcrypt local automaticamente) ───────────────
KEYCLOAK_URL=http://localhost:8082
KEYCLOAK_REALM=fga-control
KEYCLOAK_CLIENT_ID=backend-ts
KEYCLOAK_CLIENT_SECRET=dev-client-secret-change-me

# ─── Só usadas pelo docker-compose (banco e admin bootstrap do Keycloak) ──────
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Só usada por scripts/migrate-users-to-keycloak.ts (roda no host, não em
# container, por isso localhost:5433 e não o nome de rede keycloak_db) ────────
KEYCLOAK_DB_URL=postgresql://keycloak:keycloak@localhost:5433/keycloak
